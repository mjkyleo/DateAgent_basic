# basic/.env.example —— 复制为 basic/.env 并填写（.env 已 gitignore，勿提交）
# LLM（OpenAI 兼容端点：通义千问 / OpenAI / DeepSeek 等，留空则自动走规则兜底）
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=qwen-plus
LLM_TIMEOUT_S=60
# 备用模型：主模型不可用时自动切换的目标（与主模型同端点、同密钥，只换模型 ID）。
# 只有"可重试类"错误会触发切换：超时 / 连接失败 / 5xx / 429。
# 403/401 这类授权错误不切 —— 同一把钥匙换个模型不会好，盲目重试只会让每次调用多等一轮。
# 留空 = 不启用自动切换。要换端点/密钥，请用前端「模型管理」激活另一个模型。
LLM_FALLBACK_MODEL=

# 查询执行
QUERY_TIMEOUT_S=10
DEFAULT_LIMIT=1000
MAX_SAMPLE_ROWS=10

# 服务端口（避开同机其他服务）
HOST=127.0.0.1
PORT=8001

# 本地存储（数据源配置 + 会话状态）
STORE_PATH=data/store.db

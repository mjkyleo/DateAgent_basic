# basic/.env.example —— 复制为 basic/.env 并填写（.env 已 gitignore，勿提交）
# LLM（OpenAI 兼容端点：通义千问 / OpenAI / DeepSeek 等，留空则自动走规则兜底）
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=qwen-plus
LLM_TIMEOUT_S=60
# 备用模型：主模型不可用时自动切换的目标（与主模型同端点、同密钥，只换模型 ID）。
# 只有"可重试类"错误会触发切换：超时 / 连接失败 / 5xx / 429。
# 403/401 这类授权错误不切 —— 同一把钥匙换个模型不会好，盲目重试只会让每次调用多等一轮。
# 留空 = 不启用自动切换。要换端点/密钥，请用前端「模型管理」激活另一个模型。
LLM_FALLBACK_MODEL=

# 查询执行
QUERY_TIMEOUT_S=10
DEFAULT_LIMIT=1000
MAX_SAMPLE_ROWS=10

# 服务端口（避开同机其他服务）
HOST=127.0.0.1
PORT=8001

# 本地存储（数据源配置 + 会话状态）
STORE_PATH=data/store.db

# ============ 写能力（默认全关，按需显式打开）============
# 总闸：不显式设为 true，任何 CREATE/INSERT/UPDATE/DELETE/DROP 都被拒。
# 光在前端选档位、光把数据源标成可写都不够 —— 三道都得对上才写得进去。
AGENT_ALLOW_WRITES=false
# 单次写入允许的影响行数上限：预估超过就拒（让人别在没看清影响面时点确认）。
WRITE_MAX_AFFECTED_ROWS=5000
# 写前自动备份：UPDATE/DELETE 备份受影响行、DROP/TRUNCATE/删列 备份整表到
# <前缀>_<表名>_<UTC时间戳>_<6位随机>。关掉它 = 删错了没法找回。
WRITE_AUTO_BACKUP=true
WRITE_BACKUP_PREFIX=_bak
# 数据源级上限（datasources.allowed_ops）不在这里配：在「数据源」里逐源设置为
# read / write_dml / write_ddl；请求档位只能等于或低于源上限，不能自己抬。
# 系统库与本项目元数据库（AGENT_MYSQL_DATABASE，默认 data_agent）永远禁止写入。

